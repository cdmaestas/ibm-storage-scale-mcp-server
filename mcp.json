{
  "mcpServers": {
    "ibm-storage-scale": {
      "command": "uvx",
      "args": ["ibm-storage-scale-mcp-server", "--transport", "stdio"],
      "env": {
        "SCALE_API_HOSTNAME": "your-scale-cluster.example.com",
        "SCALE_API_USERNAME": "your-username",
        "SCALE_API_PASSWORD": "your-password"
      }
    }
  }
}
